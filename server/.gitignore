# Backend service. Covers Python (FastAPI) and Node (Express) so this works
# whichever stack you choose for this folder.

# === Python (FastAPI) ===
# Virtual environments
.venv/
venv/
env/
ENV/

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# === Node (Express) ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Local environment overrides ===
# Base .env / .env.* are ignored repo-wide; keep .env.example committed.
.env.local
